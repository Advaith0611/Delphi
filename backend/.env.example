GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Claude Agent SDK is the coding harness. It uses OpenRouter's Anthropic-compatible endpoint.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
PYTHIOS_CODING_MODEL=anthropic/claude-opus-5.5:batch
# Optional, comma-separated. Kept blank to let npm/pip use the normal package registries.
PYTHIOS_AGENT_MAX_TURNS=36
PYTHIOS_PUBLIC_APP_URL=https://app.pythios.xyz
# Production: mount a persistent Render disk at /var/data and set this to a
# directory on that disk. Without it, generated apps disappear on redeploy.
PYTHIOS_DATA_DIR=/var/data/pythios
# Optional: upload generated source copies to GitHub.
# Use a fine-grained token with Contents: Read and write for this repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=Advaith0611/Delphi
GITHUB_BRANCH=main
GITHUB_ARCHIVE_PATH=generated-projects
# Set true on no-disk deployments. A generation fails rather than reporting a
# non-durable public app if its GitHub archive cannot be written.
PYTHIOS_REQUIRE_GITHUB_ARCHIVE=false
# Comma-separated browser origins when the frontend is hosted elsewhere.
ALLOWED_ORIGINS=https://pythios.xyz,https://app.pythios.xyz,https://delphi.pythios.xyz
# Optional regex for additional subdomains; defaults to *.pythios.xyz.
ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)*pythios\.xyz
